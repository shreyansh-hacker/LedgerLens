# =================================================================
# LedgerLens Environment Configuration Example
# Copy this file to .env or .env.local for local execution
# NEVER commit actual API keys or secrets to version control
# =================================================================

# Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Defaults to local SQLite if DATABASE_URL is unset)
# For Supabase / PostgreSQL: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=sqlite:///./ledgerlens.db

# AI Engine (Groq API - Required in Phase 5)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Supabase Integration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional Payment Gateway Integration (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
